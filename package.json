{
  "name": "threadhop-next",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "ThreadHop's TypeScript foundation",
  "license": "MIT",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "cli": "npm run build --silent && node dist/cli.js",
